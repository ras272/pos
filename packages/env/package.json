{
  "name": "@workspace/env",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./public": {
      "types": "./src/public.ts",
      "default": "./src/public.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "browser": "./src/server.browser.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "typescript": "^5",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
